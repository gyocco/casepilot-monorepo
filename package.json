{
  "name": "@casepilot/monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev:api": "pnpm --dir src/apps/casepilot/casepilot-api dev",
    "start:api": "pnpm --dir src/apps/casepilot/casepilot-api start",
    "build:api": "pnpm --dir src/apps/casepilot/casepilot-api build",
    "typecheck:api": "pnpm --dir src/apps/casepilot/casepilot-api typecheck",
    "lint:api": "pnpm --dir src/apps/casepilot/casepilot-api lint",
    "check:api:architecture": "pnpm --dir src/apps/casepilot/casepilot-api check:architecture",
    "test:api:architecture": "pnpm --dir src/apps/casepilot/casepilot-api test:architecture",
    "test:api": "pnpm --dir src/apps/casepilot/casepilot-api test",
    "test:api:integration": "pnpm --dir src/apps/casepilot/casepilot-api test:integration",
    "migration:api:run": "pnpm --dir src/apps/casepilot/casepilot-api migration:run",
    "migration:api:show": "pnpm --dir src/apps/casepilot/casepilot-api migration:show",
    "dev:web": "pnpm --dir src/apps/casepilot/casepilot-web dev",
    "lint:web": "pnpm --dir src/apps/casepilot/casepilot-web lint",
    "build:web": "pnpm --dir src/apps/casepilot/casepilot-web build",
    "infra:env": "node tools/scripts/setup-local-env.mjs",
    "infra:up": "pnpm infra:env && docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml up -d --wait --wait-timeout 120",
    "infra:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml down",
    "infra:status": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml ps",
    "infra:logs": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml logs --follow --tail 100",
    "infra:check": "pnpm infra:env && docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml config --quiet"
  }
}
