{
  "name": "@casepilot/abstractions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure shared backend contracts, base data models, pagination models and error vocabulary",
  "engines": { "node": ">=22.12.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test eslint.config.mjs --max-warnings 0",
    "test": "tsc -p tsconfig.test.json && node --test build/test/test/unit/*.test.js",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.12.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
