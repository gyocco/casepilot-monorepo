{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "lib": ["ES2022"], "types": [],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noImplicitOverride": true, "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true, "declaration": true
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist", "build"]
}
