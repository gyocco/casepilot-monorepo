# Optional local API overrides. Docker credentials are read from infra/docker/.env.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3000
# API_ERROR_DETAILS=true
# Default true in local/test/development, false in staging/production.
# CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
# AUTH_FIREBASE_PROJECT_ID=demo-casepilot-local
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Non-local environments must set AUTH_FIREBASE_PROJECT_ID explicitly and never FIREBASE_AUTH_EMULATOR_HOST.
# DATABASE_URL=postgresql://user:REPLACE_WITH_PASSWORD@host:5432/database
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=55432
# DATABASE_NAME=casepilot
# DATABASE_USER=casepilot
# DATABASE_PASSWORD=REPLACE_WITH_PASSWORD
# DATABASE_SCHEMA=public
# DATABASE_SSL=false
# DATABASE_SSL_CA_FILE=/absolute/path/to/ca.pem
# DATABASE_CONNECT_TIMEOUT_MS=3000
# DATABASE_QUERY_TIMEOUT_MS=3000
# DATABASE_STATEMENT_TIMEOUT_ENABLED=true
# Set DATABASE_STATEMENT_TIMEOUT_ENABLED=false when connecting via a transaction-mode pooler (e.g., Neon -pooler / PgBouncer).
# DATABASE_POOL_SIZE=5

# Non-local deployments must explicitly set APP_ENV and database credentials.
# APP_ENV: local, test, development, staging, production.
# TLS verifies server certificates by default outside local/test.
