{
  "name": "@casepilot/casepilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CasePilot Angular LTS SPA",
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "scripts": {
    "build:ui-kit": "pnpm --filter @casepilot/pilot-ui-kit build",
    "dev": "pnpm build:ui-kit && ng serve --host 127.0.0.1",
    "build": "pnpm build:ui-kit && ng build",
    "typecheck": "pnpm build:ui-kit && ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test *.mjs --max-warnings 0",
    "test": "pnpm build:ui-kit && vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@casepilot/pilot-ui-kit": "workspace:*",
    "firebase": "13.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.11.0",
    "@casepilot/frontend-architecture": "workspace:*",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.12.0",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jsdom": "27.4.0",
    "postcss": "8.5.6",
    "sass": "1.97.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
